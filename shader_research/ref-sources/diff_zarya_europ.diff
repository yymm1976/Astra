+++ b/tools/sync-europ/sync.js
@@ -0,0 +1,431 @@
+#!/usr/bin/env node
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const reforged = path.resolve(here, "../..");
+const blockProps = path.join(reforged, "shaders", "block.properties");
+const cacheDir = path.join(here, ".cache");
+const mapper = JSON.parse(readFileSync(path.join(here, "mapper.json"), "utf8"));
+
+const REPO = "https://github.com/EuphoriaPatches/propertiesFiles";
+const RAW =
+  "https://raw.githubusercontent.com/EuphoriaPatches/propertiesFiles/main/blockProperties/1.13%2B";
+
+const SOURCE_FILES = [
+  "block.5000-10070.properties",
+  "block.10072-10152.properties",
+  "block.10153-10232.properties",
+  "block.10233-10336.properties",
+  "block.10337-10447.properties",
+  "block.10448-10592.properties",
+  "block.10596-10729.properties",
+  "block.10733-10843.properties",
+  "block.10844-10941.properties",
+  "block.10944-21044.properties",
+  "block.21046-32016.properties",
+];
+
+const wrapAt = 100;
+const NEUTRAL = ["white", ...Object.keys(mapper.neutral || {})];
+const colorAlt = [...(mapper.colors || [])].sort((a, b) => b.length - a.length).join("|");
+const COLOR_COMMENT = new RegExp(`^# (?:${colorAlt})(?: stained glass)?$|^# tinted glass$`);
+
+function parseArgs() {
+  let dry = false;
+  let local = null;
+  const argv = process.argv.slice(2);
+  for (let i = 0; i < argv.length; i++) {
+    if (argv[i] === "--dry-run") dry = true;
+    else if (argv[i] === "--local") local = argv[++i];
+    else throw new Error(`unknown arg: ${argv[i]}`);
+  }
+  return { dry, local };
+}
+
+async function fetchSources(localDir) {
+  if (localDir) {
+    const base = path.resolve(localDir);
+    return SOURCE_FILES.map((f) => readFileSync(path.join(base, f), "utf8")).join("\n");
+  }
+
+  mkdirSync(cacheDir, { recursive: true });
+  const chunks = [];
+  for (const f of SOURCE_FILES) {
+    const url = `${RAW}/${f}`;
+    console.error("fetch", url);
+    const res = await fetch(url);
+    if (!res.ok) throw new Error(`${url} -> ${res.status}`);
+    const text = await res.text();
+    writeFileSync(path.join(cacheDir, f), text);
+    chunks.push(text);
+  }
+  return chunks.join("\n");
+}
+
+function parseProps(text) {
+  const out = new Map();
+  let id = null;
+  let buf = [];
+  let comment = "";
+
+  const flush = () => {
+    if (id == null) return;
+    const toks = buf.join(" ").trim().split(/\s+/).filter(Boolean);
+    if (out.has(id)) {
+      const prev = out.get(id);
+      const seen = new Set(prev.tokens);
+      for (const t of toks) if (!seen.has(t)) prev.tokens.push(t);
+    } else {
+      out.set(id, { tokens: toks, comment });
+    }
+    id = null;
+    buf = [];
+  };
+
+  for (let line of text.split(/\r?\n/)) {
+    line = line.trim();
+    if (!line) {
+      flush();
+      continue;
+    }
+    if (line.startsWith("#")) {
+      if (
+        !line.startsWith("#if") &&
+        !line.startsWith("#else") &&
+        !line.startsWith("#endif") &&
+        !line.startsWith("###") &&
+        !line.startsWith("# Copyright")
+      ) {
+        const c = line.replace(/^#+\s*/, "");
+        if (c) comment = c;
+      }
+      continue;
+    }
+
+    const m = line.match(/^block\.(\d+)\s*=\s*(.*)$/);
+    if (m) {
+      flush();
+      id = Number(m[1]);
+      let rest = m[2].trim();
+      const cont = rest.endsWith("\\");
+      if (cont) rest = rest.slice(0, -1).trim();
+      buf = rest ? [rest] : [];
+      if (!cont) flush();
+      continue;
+    }
+
+    if (id != null) {
+      const cont = line.endsWith("\\");
+      const rest = cont ? line.slice(0, -1).trim() : line;
+      if (rest) buf.push(rest);
+      if (!cont) flush();
+    }
+  }
+  flush();
+  return out;
+}
+
+function isMod(tok) {
+  if (tok.startsWith("tags_") || tok.startsWith("%") || tok.startsWith("rf_tag_")) return false;
+  const parts = tok.split(":");
+  if (parts.length < 2) return false;
+  return !parts[1].includes("=");
+}
+
+function nameOf(tok) {
+  return (tok.split(":")[1] || tok).split(":")[0].toLowerCase();
+}
+
+function wordHit(name, word) {
+  return new RegExp(`(^|_)${word}(_|$)`).test(name);
+}
+
+function splitNeutral(tok) {
+  const n = nameOf(tok);
+  for (const [color, words] of Object.entries(mapper.neutral)) {
+    if (words.some((w) => wordHit(n, w))) return color;
+  }
+  return "white";
+}
+
+function dyeFromName(tok) {
+  const n = nameOf(tok);
+  for (const c of mapper.colors) {
+    if (wordHit(n, c)) return c;
+  }
+  return "white";
+}
+
+function checkPalette() {
+  const dyeKeys = Object.keys(mapper.dye);
+  const colors = mapper.colors;
+  if (!Array.isArray(colors) || !colors.length) throw new Error("mapper.json colors missing");
+  if (new Set(colors).size !== colors.length) throw new Error("mapper.json colors has duplicates");
+  for (const c of colors) {
+    if (!mapper.dye[c]) throw new Error(`mapper.json colors has ${c} missing from dye`);
+  }
+  for (const c of dyeKeys) {
+    if (!colors.includes(c)) throw new Error(`mapper.json dye has ${c} missing from colors`);
+  }
+  for (const [color, words] of Object.entries(mapper.neutral || {})) {
+    if (!mapper.dye[color]) throw new Error(`mapper.json neutral has ${color} missing from dye`);
+    if (!Array.isArray(words)) throw new Error(`mapper.json neutral.${color} must be a list`);
+  }
+}
+
+function matches(pattern, tok) {
+  if (pattern.startsWith("*") && pattern.endsWith("*") && pattern.length > 2) {
+    return tok.includes(pattern.slice(1, -1));
+  }
+  if (pattern.endsWith("*")) return tok.startsWith(pattern.slice(0, -1));
+  return tok === pattern;
+}
+
+function movedTo(tok) {
+  for (const rule of mapper.move || []) {
+    if (!(rule.match || []).some((p) => matches(p, tok))) continue;
+    if (rule.dyeFromName) {
+      const color = dyeFromName(tok);
+      const id = mapper.dye[color];
+      if (!id) throw new Error(`mapper.json dye missing ${color}`);
+      return id;
+    }
+    return rule.to;
+  }
+  return null;
+}
+
+function destOf(rule, tok) {
+  const moved = movedTo(tok);
+  if (moved != null) return moved;
+  if (rule && typeof rule === "object" && rule.splitNeutral) {
+    const color = splitNeutral(tok);
+    const id = mapper.dye[color];
+    if (!id || !NEUTRAL.includes(color)) throw new Error(`bad neutral split for ${tok}`);
+    return id;
+  }
+  return rule;
+}
+
+function rank(zarya) {
+  if (zarya >= 21070 && zarya <= 21085) return 0;
+  if (zarya === 10014) return 3;
+  if ((zarya >= 21000 && zarya <= 21016) || zarya === 20018) return 2;
+  return 1;
+}
+
+function checkCoverage(sections) {
+  const known = new Set([
+    ...Object.keys(mapper.map),
+    ...(mapper.ignore || []).map(String),
+  ]);
+  const source = new Set([...sections.keys()].map(String));
+  const fresh = [...source].filter((id) => !known.has(id)).sort((a, b) => a - b);
+  const stale = [...known].filter((id) => !source.has(id)).sort((a, b) => a - b);
+  if (!fresh.length && !stale.length) return;
+
+  if (fresh.length) {
+    console.error(`new euphoria block ids (${fresh.length}). Add each to mapper.json map or ignore:`);
+    for (const id of fresh) {
+      console.error(`  ${id}  ${sections.get(Number(id)).comment || ""}`);
+    }
+  }
+  if (stale.length) {
+    console.error(`mapper.json ids missing from euphoria (${stale.length}):`);
+    for (const id of stale) console.error(`  ${id}`);
+  }
+  process.exit(1);
+}
+
+function buildBuckets(sections) {
+  const buckets = new Map();
+  const owner = new Map();
+  let overlaps = 0;
+
+  const put = (tok, dest) => {
+    const prev = owner.get(tok);
+    if (prev == null) {
+      owner.set(tok, dest);
+      if (!buckets.has(dest)) buckets.set(dest, new Set());
+      buckets.get(dest).add(tok);
+      return;
+    }
+    if (prev === dest) return;
+    overlaps++;
+    if (rank(dest) < rank(prev)) {
+      buckets.get(prev).delete(tok);
+      owner.set(tok, dest);
+      if (!buckets.has(dest)) buckets.set(dest, new Set());
+      buckets.get(dest).add(tok);
+    }
+  };
+
+  for (const [eid, rule] of Object.entries(mapper.map)) {
+    const section = sections.get(Number(eid));
+    if (!section) throw new Error(`mapper.json map has unknown euphoria id ${eid}`);
+    for (const tok of section.tokens) {
+      if (!isMod(tok)) continue;
+      put(tok, destOf(rule, tok));
+    }
+  }
+
+  const targets = new Set();
+  for (const rule of Object.values(mapper.map)) {
+    if (typeof rule === "number") targets.add(rule);
+  }
+  for (const id of Object.values(mapper.dye)) targets.add(id);
+  for (const rule of mapper.move || []) if (rule.to) targets.add(rule.to);
+
+  return { buckets, targets: [...targets].sort((a, b) => a - b), overlaps };
+}
+
+function byMod(tokens) {
+  const g = new Map();
+  for (const t of tokens) {
+    const mod = t.split(":")[0];
+    if (!g.has(mod)) g.set(mod, []);
+    g.get(mod).push(t);
+  }
+  for (const list of g.values()) list.sort();
+  return [...g.entries()].sort((a, b) => a[0].localeCompare(b[0]));
+}
+
+function wrapGroups(groups) {
+  const lines = [];
+  for (const [, toks] of groups) {
+    let cur = "";
+    for (const t of toks) {
+      const next = cur ? `${cur} ${t}` : t;
+      if (cur && next.length > wrapAt) {
+        lines.push(cur + " \\");
+        cur = t;
+      } else cur = next;
+    }
+    if (cur) lines.push(cur + " \\");
+    lines.push("\\");
+  }
+  while (lines.length && lines[lines.length - 1] === "\\") lines.pop();
+  if (lines.length && lines[lines.length - 1].endsWith(" \\")) {
+    lines[lines.length - 1] = lines[lines.length - 1].slice(0, -2);
+  }
+  return lines;
+}
+
+function emitBlock(id, prefix, mods) {
+  const begin = `# BEGIN generated:euphoria:${id}`;
+  const end = `# END generated:euphoria:${id}`;
+  const head = [
+    begin,
+    `# Generated by tools/sync-europ/sync.js from ${REPO}`,
+    "# Copyright (c) 2026 SpacEagle17 – MIT License (see THIRD_PARTY_NOTICES.md)",
+    `block.${id} = ${prefix.join(" ")}`,
+  ];
+  if (!mods.length) {
+    return [...head, end];
+  }
+  head[head.length - 1] += " \\";
+  return [...head, "\\", ...wrapGroups(byMod(mods)), end];
+}
+
+function stripOldMarkers(lines) {
+  return lines.filter((line) => {
+    const t = line.trim();
+    if (t.startsWith("# BEGIN generated:euphoria")) return false;
+    if (t.startsWith("# END generated:euphoria")) return false;
+    if (t.startsWith("# Generated by tools/sync-europ/")) return false;
+    if (t.startsWith("# Copyright (c) 2026 SpacEagle17")) return false;
+    if (t.startsWith("# Manual fixes:")) return false;
+    if (t === "# dye light") return false;
+    return true;
+  });
+}
+
+function findAssignment(lines, id) {
+  const re = new RegExp(`^block\\.${id}\\s*=`);
+  for (let i = 0; i < lines.length; i++) {
+    if (!re.test(lines[i].trim())) continue;
+    let start = i;
+    if (start > 0 && COLOR_COMMENT.test(lines[start - 1].trim())) start--;
+    let end = i;
+    while (end < lines.length - 1 && lines[end].trimEnd().endsWith("\\")) end++;
+    return { start, end };
+  }
+  return null;
+}
+
+function generatedIds(lines) {
+  const ids = new Set();
+  let on = false;
+  for (const line of lines) {
+    const t = line.trim();
+    if (t.startsWith("# BEGIN generated:euphoria")) on = true;
+    else if (t.startsWith("# END generated:euphoria")) on = false;
+    else if (on) {
+      const m = t.match(/^block\.(\d+)\s*=/);
+      if (m) ids.add(Number(m[1]));
+    }
+  }
+  return ids;
+}
+
+function applyBuckets(src, buckets, targets) {
+  const raw = src.split(/\n/);
+  const managed = new Set([...targets, ...generatedIds(raw)]);
+  let lines = stripOldMarkers(raw);
+  if (lines.length && lines[lines.length - 1] === "") lines.pop();
+  targets = [...managed].sort((a, b) => a - b);
+
+  const parsed = parseProps(lines.join("\n"));
+  const jobs = [];
+  for (const id of targets) {
+    const found = findAssignment(lines, id);
+    if (!found) throw new Error(`block.properties has no block.${id}`);
+    const existing = parsed.get(id);
+    const prefix = (existing ? existing.tokens : []).filter((t) => !isMod(t));
+    if (!prefix.length) throw new Error(`block.${id} lost its vanilla prefix`);
+    const mods = [...(buckets.get(id) || [])].sort();
+    jobs.push({ ...found, id, text: emitBlock(id, prefix, mods) });
+  }
+
+  jobs.sort((a, b) => b.start - a.start);
+  for (const job of jobs) {
+    lines.splice(job.start, job.end - job.start + 1, ...job.text);
+  }
+  return lines.join("\n") + "\n";
+}
+
+async function main() {
+  checkPalette();
+  const { dry, local } = parseArgs();
+  const sections = parseProps(await fetchSources(local));
+  checkCoverage(sections);
+
+  const { buckets, targets, overlaps } = buildBuckets(sections);
+  const count = [...buckets.values()].reduce((n, s) => n + s.size, 0);
+  console.error(
+    `euphoria ${sections.size} | mapped ${Object.keys(mapper.map).length} | ignored ${(mapper.ignore || []).length} | tokens ${count} | overlaps ${overlaps}`,
+  );
+
+  if (dry) {
+    for (const id of targets) {
+      console.log(`block.${id}  ${(buckets.get(id) || new Set()).size}`);
+    }
+    return;
+  }
+
+  const prev = readFileSync(blockProps, "utf8");
+  const next = applyBuckets(prev, buckets, targets);
+  if (next === prev) {
+    console.error("already up to date");
+    return;
+  }
+  writeFileSync(blockProps, next);
+  console.error("updated shaders/block.properties");
+}
+
+main().catch((e) => {
+  console.error(e);
+  process.exit(1);
+});
