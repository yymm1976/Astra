diff --git a/shaders/common/colorSplash.glsl b/shaders/common/colorSplash.glsl
new file mode 100644
index 0000000..bdf8302
--- /dev/null
+++ b/shaders/common/colorSplash.glsl
@@ -0,0 +1,48 @@
+#ifndef RF_COLOR_SPLASH_GLSL
+#define RF_COLOR_SPLASH_GLSL
+
+float rfSplashHue(vec3 color, float chroma) {
+   float sector;
+   if (color.r >= color.g && color.r >= color.b) {
+      sector = (color.g - color.b) / chroma;
+   } else if (color.g >= color.b) {
+      sector = 2.0 + (color.b - color.r) / chroma;
+   } else {
+      sector = 4.0 + (color.r - color.g) / chroma;
+   }
+   return fract(sector / 6.0);
+}
+
+vec3 rfColorSplash(vec3 color) {
+   float y = luma(color);
+   float maxC = max(color.r, max(color.g, color.b));
+   float minC = min(color.r, min(color.g, color.b));
+   float chroma = maxC - minC;
+   if (chroma <= 0.0001) {
+      return vec3(y);
+   }
+
+   float sat = chroma / max(maxC, 0.0001);
+   float hue = rfSplashHue(color, chroma);
+
+   #if COLOR_SPLASH_HUE == 1
+      float target = 1.0 / 3.0;
+   #elif COLOR_SPLASH_HUE == 2
+      float target = 2.0 / 3.0;
+   #else
+      float target = 0.0;
+   #endif
+
+   float dist = abs(hue - target);
+   dist = min(dist, 1.0 - dist);
+
+   float range = max(float(COLOR_SPLASH_RANGE), 0.02);
+   float hueKeep = 1.0 - smoothstep(range * 0.55, range, dist);
+
+   float purity = clamp(float(COLOR_SPLASH_PURITY), 0.0, 0.95);
+   float satKeep = smoothstep(purity * 0.85, min(purity + 0.22, 1.0), sat);
+
+   return mix(vec3(y), color, hueKeep * satKeep);
+}
+
+#endif
