option.UNDERWATER_LIGHT_SHAFTS=§eUnderwater Sun Shafts§r
option.UNDERWATER_LIGHT_SHAFTS.comment=Enables sunbeams underwater, lit through the water surface and shadow blockers. §e[*]§r Requires Shadows; independent of the Godrays in Post Processing. §c[-]§r Enabling it raises the water scene buffer to full resolution.
option.UNDERWATER_SHAFT_STRENGTH=Underwater Shaft Strength
option.UNDERWATER_SHAFT_STRENGTH.comment=Adjusts the brightness of underwater sun shafts without changing underwater fog density.
option.UNDERWATER_SHAFT_SAMPLES=§eUnderwater Shaft Detail§r
option.UNDERWATER_SHAFT_SAMPLES.comment=Determines how many shadow samples each underwater light ray takes (4-10). Higher values preserve narrower shafts at a greater GPU cost.
value.UNDERWATER_SHAFT_SAMPLES.16=Fast
value.UNDERWATER_SHAFT_SAMPLES.24=Balanced
value.UNDERWATER_SHAFT_SAMPLES.32=Fine
