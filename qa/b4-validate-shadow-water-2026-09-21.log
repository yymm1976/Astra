[3] 当前 pack 的阴影投影实现：位置与数学形态
================================================================================
注意：任务给的路径 Astra/shaders/global/shadow/distort.glsl **不存在**；
      全库按文件名/内容检索（SHADOW_DISTORT、distort）命中处即下列文件。

主实现：Astra/shaders/lib/distort.glsl
  :16  const float SHADOW_DISTORT_CORE = 25.6;
  :17  const float SHADOW_DISTORT_FACTOR = SHADOW_DISTORT_CORE / float(SHADOW_DISTANCE);
  :19  float get_distort_factor(vec2 pos) {
  :20      return length(pos) + SHADOW_DISTORT_FACTOR;
  :21  }
  :24  vec3 distort(vec3 pos) {
  :25      #ifdef DIMENSION_END
  :26      return vec3(pos.xy,pos.z*0.5);
  :27      #else
  :28      float factor = get_distort_factor(pos.xy);
  :29      return vec3(pos.xy / factor, pos.z * 0.5);
  :33  vec3 undistort(vec3 pos) {   // 解析逆：q = p/(|p|+a) → p = q * a/(1-|q|)，像域为开单位圆盘
  :39      float factor = SHADOW_DISTORT_FACTOR / max(1.0 - length(pos.xy), 1e-5);
  :40      return vec3(pos.xy * factor, pos.z / 0.5);

