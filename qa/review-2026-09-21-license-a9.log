    21	}
    22	
    23	// Shadow clip space distortion: packs resolution near the player
    24	vec3 distort(vec3 pos) {
    25	    #ifdef DIMENSION_END
    26	    return vec3(pos.xy,pos.z*0.5);
    27	    #else
    28	    float factor = get_distort_factor(pos.xy);
    29	    return vec3(pos.xy / factor, pos.z * 0.5);
    30	    #endif
    31	}
    32	
    33	vec3 undistort(vec3 pos) {
    34	    #ifdef DIMENSION_END
    35	    return vec3(pos.xy,pos.z/0.5);
    36	    #else
    37	    // Analytic inverse of q = p / (length(p) + a). The image of finite
    38	    // points is the open unit disk; callers must reject its unused corners.
    39	    float factor = SHADOW_DISTORT_FACTOR / max(1.0 - length(pos.xy), 1e-5);
    40	    return vec3(pos.xy * factor, pos.z / 0.5);
    41	    #endif
    42	}
